<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../FsCopilot/Simulation/Definitions.cs" Link="Production/Definitions.cs" />
    <Compile Include="../FsCopilot/Simulation/Coordinator.cs" Link="Production/Coordinator.cs" />
    <Compile Include="../FsCopilot/Network/IPacketCodec.cs" Link="Production/IPacketCodec.cs" />
    <Content Include="../Definitions/**/*.yaml" Link="Definitions/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/OriginalBaron.yaml" Link="Definitions/original-baron.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../FsCopilot/Connection/SimClient.cs" Link="Source/SimClient.cs" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <PackageReference Include="Jint" Version="4.4.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Reactive.Concurrency" />
    <Using Include="System.Reactive.Disposables" />
    <Using Include="System.Reactive.Linq" />
    <Using Include="System.Reactive.Subjects" />
    <Using Include="Serilog" />
  </ItemGroup>
</Project>
